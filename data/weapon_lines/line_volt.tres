script = ExtResource("1")
id = "line_volt"
hero = "hero_volt"
tiers = Array[Dictionary]([{"name": "Storm Sling", "desc": "Fires a stone at the nearest creature.", "icon": "res://assets/sprites/icons/w_sling.svg", "power": 1.0, "add": {}, "strikes": []}, {"name": "Crossbow", "desc": "Heavy bolts that pass through two creatures.", "icon": "res://assets/sprites/icons/t_bow.svg", "power": 1.2, "add": {"speed": 250.0, "pierce": 2.0}, "strikes": [], "sprite": "res://assets/sprites/arrow.svg"}, {"name": "Hand Cannon", "desc": "Iron shot that bursts on impact.", "icon": "res://assets/sprites/icons/t_cannon.svg", "power": 1.45, "add": {"explode_radius": 50.0, "cooldown": 0.2}, "strikes": [], "sprite": "res://assets/sprites/shell.svg"}, {"name": "Volley Gun", "desc": "Several barrels fire at once.", "icon": "res://assets/sprites/icons/t_musket.svg", "power": 1.7, "add": {"speed": 450.0, "pierce": 1.0, "projectiles": 2.0}, "strikes": [], "sprite": "res://assets/sprites/bullet.svg"}, {"name": "Rotary Gun", "desc": "Spinning barrels pour out rounds.", "icon": "res://assets/sprites/icons/t_heavy_gun.svg", "power": 2.0, "add": {"speed": 500.0, "pierce": 2.0, "projectiles": 2.0, "cooldown": -0.35}, "strikes": [], "sprite": "res://assets/sprites/bullet.svg"}, {"name": "Rotary Gun + Rockets", "desc": "Rounds and a rocket battery. Calls a Rocket Battery every 8 s.", "icon": "res://assets/sprites/icons/t_missiles.svg", "power": 2.3, "add": {"speed": 500.0, "pierce": 2.0, "projectiles": 2.0, "cooldown": -0.35}, "strikes": [{"type": "missiles", "name": "Rocket Battery", "cooldown": 8.0, "damage": 55.0, "area": 100.0, "count": 5.0}], "sprite": "res://assets/sprites/bullet.svg"}, {"name": "Sky Lance", "desc": "Rounds, rockets and a jet pass. Calls a Rocket Battery every 8 s. Calls a Sky Lance Jet every 10 s.", "icon": "res://assets/sprites/icons/t_jet.svg", "power": 2.7, "add": {"speed": 550.0, "pierce": 3.0, "projectiles": 3.0, "cooldown": -0.4}, "strikes": [{"type": "missiles", "name": "Rocket Battery", "cooldown": 8.0, "damage": 55.0, "area": 100.0, "count": 5.0}, {"type": "jet", "name": "Sky Lance Jet", "cooldown": 10.0, "damage": 70.0, "area": 110.0}], "sprite": "res://assets/sprites/bullet.svg"}])
