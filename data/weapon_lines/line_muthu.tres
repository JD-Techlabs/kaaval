tiers = Array[Dictionary]([{"name": "Sling Stone", "desc": "Fires a stone at the nearest creature.", "icon": "res://assets/sprites/icons/w_sling.svg", "power": 1.0, "add": {}, "strikes": []}, {"name": "Longbow", "desc": "Arrows fly fast and pass through a creature.", "icon": "res://assets/sprites/icons/t_bow.svg", "power": 1.2, "add": {"speed": 200.0, "pierce": 1.0}, "strikes": [], "sprite": "res://assets/sprites/arrow.svg"}, {"name": "Musket", "desc": "Lead shot that punches through two creatures.", "icon": "res://assets/sprites/icons/t_musket.svg", "power": 1.45, "add": {"speed": 400.0, "pierce": 1.0, "cooldown": -0.05}, "strikes": [], "sprite": "res://assets/sprites/bullet.svg"}, {"name": "Rifle", "desc": "Quick, accurate rifle fire.", "icon": "res://assets/sprites/icons/t_rifle.svg", "power": 1.7, "add": {"speed": 500.0, "pierce": 2.0, "projectiles": 1.0, "cooldown": -0.15}, "strikes": [], "sprite": "res://assets/sprites/bullet.svg"}, {"name": "Heavy Gun", "desc": "A storm of heavy rounds.", "icon": "res://assets/sprites/icons/t_heavy_gun.svg", "power": 2.0, "add": {"speed": 500.0, "pierce": 2.0, "projectiles": 2.0, "cooldown": -0.3}, "strikes": [], "sprite": "res://assets/sprites/bullet.svg"}, {"name": "Heavy Gun + Tank", "desc": "Heavy rounds, with a tank rolling in to help. Calls a Tank Escort every 12 s.", "icon": "res://assets/sprites/icons/t_tank.svg", "power": 2.3, "add": {"speed": 500.0, "pierce": 2.0, "projectiles": 2.0, "cooldown": -0.3}, "strikes": [{"type": "tank", "name": "Tank Escort", "cooldown": 12.0, "damage": 45.0, "area": 90.0, "count": 6.0}], "sprite": "res://assets/sprites/bullet.svg"}, {"name": "Heavy Gun + Air Support", "desc": "Heavy rounds, jets and missiles. Calls a Jet Pass every 10 s. Calls a Missile Volley every 8 s.", "icon": "res://assets/sprites/icons/t_jet.svg", "power": 2.7, "add": {"speed": 500.0, "pierce": 3.0, "projectiles": 2.0, "cooldown": -0.35}, "strikes": [{"type": "jet", "name": "Jet Pass", "cooldown": 10.0, "damage": 70.0, "area": 110.0}, {"type": "missiles", "name": "Missile Volley", "cooldown": 8.0, "damage": 55.0, "area": 100.0, "count": 4.0}], "sprite": "res://assets/sprites/bullet.svg"}])
