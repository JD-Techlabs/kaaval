[resource]
script = ExtResource("1")
id = "line_gale"
hero = "hero_gale"
tiers = Array[Dictionary]([{"name": "Valari", "desc": "A curved blade thrown out and back.", "icon": "res://assets/sprites/icons/w_valari.svg", "power": 1.0, "add": {}, "strikes": []}, {"name": "War Boomerang", "desc": "Flies further and hits harder.", "icon": "res://assets/sprites/icons/w_valari.svg", "power": 1.2, "add": {"range": 60.0}, "strikes": []}, {"name": "Steel Disc", "desc": "Spinning steel discs.", "icon": "res://assets/sprites/icons/t_disc.svg", "power": 1.45, "add": {"projectiles": 1.0, "range": 80.0}, "strikes": [], "sprite": "res://assets/sprites/disc.svg"}, {"name": "Twin Discs", "desc": "Fast discs that reach far.", "icon": "res://assets/sprites/icons/t_disc.svg", "power": 1.7, "add": {"projectiles": 1.0, "range": 100.0, "speed": 100.0}, "strikes": [], "sprite": "res://assets/sprites/disc.svg"}, {"name": "Buzz Blades", "desc": "A flurry of buzzing blades.", "icon": "res://assets/sprites/icons/t_disc.svg", "power": 2.0, "add": {"projectiles": 2.0, "range": 120.0, "speed": 150.0}, "strikes": [], "sprite": "res://assets/sprites/disc.svg"}, {"name": "Buzz Blades + Rotor Strike", "desc": "Blades and a fast jet strike. Calls a Rotor Strike every 10 s.", "icon": "res://assets/sprites/icons/t_jet.svg", "power": 2.3, "add": {"projectiles": 2.0, "range": 130.0, "speed": 150.0}, "strikes": [{"type": "jet", "name": "Rotor Strike", "cooldown": 10.0, "damage": 70.0, "area": 110.0}], "sprite": "res://assets/sprites/disc.svg"}, {"name": "Storm Blades", "desc": "Blades, jet strikes and missiles. Calls a Rotor Strike every 10 s. Calls a Missile Volley every 8 s.", "icon": "res://assets/sprites/icons/t_jet.svg", "power": 2.7, "add": {"projectiles": 3.0, "range": 140.0, "speed": 180.0}, "strikes": [{"type": "jet", "name": "Rotor Strike", "cooldown": 10.0, "damage": 70.0, "area": 110.0}, {"type": "missiles", "name": "Missile Volley", "cooldown": 8.0, "damage": 55.0, "area": 100.0, "count": 4.0}], "sprite": "res://assets/sprites/disc.svg"}])
