tiers = Array[Dictionary]([{"name": "Bamboo Spear", "desc": "Thrown ahead, passes through creatures.", "icon": "res://assets/sprites/icons/w_bamboo_spear.svg", "power": 1.0, "add": {}, "strikes": []}, {"name": "Iron Pike", "desc": "A heavier spear that pierces more.", "icon": "res://assets/sprites/icons/t_pike.svg", "power": 1.2, "add": {"pierce": 1.0}, "strikes": [], "sprite": "res://assets/sprites/pike.svg"}, {"name": "Bayonet Lance", "desc": "A long lance, thrown fast.", "icon": "res://assets/sprites/icons/t_pike.svg", "power": 1.45, "add": {"pierce": 2.0, "speed": 150.0}, "strikes": [], "sprite": "res://assets/sprites/pike.svg"}, {"name": "Harpoon Gun", "desc": "Harpoons fired through whole packs.", "icon": "res://assets/sprites/icons/t_pike.svg", "power": 1.7, "add": {"pierce": 3.0, "speed": 300.0, "cooldown": -0.15}, "strikes": [], "sprite": "res://assets/sprites/pike.svg"}, {"name": "Rail Spike", "desc": "A spike fired at great speed.", "icon": "res://assets/sprites/icons/t_pike.svg", "power": 2.0, "add": {"pierce": 5.0, "speed": 500.0, "cooldown": -0.3}, "strikes": [], "sprite": "res://assets/sprites/pike.svg"}, {"name": "Rail Spike + Tank", "desc": "Rail spikes and a tank escort. Calls a Tank Escort every 12 s.", "icon": "res://assets/sprites/icons/t_tank.svg", "power": 2.3, "add": {"pierce": 5.0, "speed": 500.0, "cooldown": -0.3}, "strikes": [{"type": "tank", "name": "Tank Escort", "cooldown": 12.0, "damage": 45.0, "area": 90.0, "count": 6.0}], "sprite": "res://assets/sprites/pike.svg"}, {"name": "Rail Battery", "desc": "Rail spikes, a tank and missiles. Calls a Tank Escort every 12 s. Calls a Missile Volley every 8 s.", "icon": "res://assets/sprites/icons/t_missiles.svg", "power": 2.7, "add": {"pierce": 6.0, "speed": 550.0, "cooldown": -0.35}, "strikes": [{"type": "tank", "name": "Tank Escort", "cooldown": 12.0, "damage": 45.0, "area": 90.0, "count": 6.0}, {"type": "missiles", "name": "Missile Volley", "cooldown": 8.0, "damage": 55.0, "area": 100.0, "count": 4.0}], "sprite": "res://assets/sprites/pike.svg"}])
