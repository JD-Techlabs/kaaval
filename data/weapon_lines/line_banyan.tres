tiers = Array[Dictionary]([{"name": "Thorn Whip", "desc": "A wide lash in front of you.", "icon": "res://assets/sprites/icons/w_thorn_whip.svg", "power": 1.0, "add": {}, "strikes": []}, {"name": "Chain Flail", "desc": "A heavier, wider swing.", "icon": "res://assets/sprites/icons/t_flail.svg", "power": 1.2, "add": {"width": 30.0}, "strikes": []}, {"name": "Bayonet Sweep", "desc": "A long sweeping thrust.", "icon": "res://assets/sprites/icons/t_sabre.svg", "power": 1.45, "add": {"width": 50.0, "height": 20.0}, "strikes": []}, {"name": "Sabre Arc", "desc": "A fast, wide sabre arc.", "icon": "res://assets/sprites/icons/t_sabre.svg", "power": 1.7, "add": {"width": 70.0, "height": 30.0, "cooldown": -0.1}, "strikes": []}, {"name": "Steam Hammer", "desc": "A crushing steam-driven blow.", "icon": "res://assets/sprites/icons/t_hammer.svg", "power": 2.0, "add": {"width": 90.0, "height": 40.0, "cooldown": -0.15}, "strikes": []}, {"name": "Steam Hammer + Tank", "desc": "Crushing blows and a tank escort. Calls a Tank Escort every 12 s.", "icon": "res://assets/sprites/icons/t_tank.svg", "power": 2.3, "add": {"width": 100.0, "height": 45.0, "cooldown": -0.15}, "strikes": [{"type": "tank", "name": "Tank Escort", "cooldown": 12.0, "damage": 45.0, "area": 90.0, "count": 6.0}]}, {"name": "Siege Hammer", "desc": "Crushing blows, a tank and missiles. Calls a Siege Tank every 12 s. Calls a Missile Volley every 8 s.", "icon": "res://assets/sprites/icons/t_tank.svg", "power": 2.7, "add": {"width": 120.0, "height": 50.0, "cooldown": -0.2}, "strikes": [{"type": "tank", "name": "Siege Tank", "cooldown": 12.0, "damage": 45.0, "area": 90.0, "count": 6.0}, {"type": "missiles", "name": "Missile Volley", "cooldown": 8.0, "damage": 55.0, "area": 100.0, "count": 4.0}]}])
