[gd_resource type="Resource" script_class="WeaponLineData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/weapon_line_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "line_ammu"
hero = "hero_ammu"
tiers = Array[Dictionary]([{"name": "Lamp Orbit", "desc": "Flames circle you and burn on touch.", "icon": "res://assets/sprites/icons/w_lamp_orbit.svg", "power": 1.0, "add": {}, "strikes": []}, {"name": "Torch Ring", "desc": "More flames, burning hotter.", "icon": "res://assets/sprites/icons/t_torch.svg", "power": 1.2, "add": {"flames": 1.0}, "strikes": []}, {"name": "Powder Flares", "desc": "Sparkling flares circle wider.", "icon": "res://assets/sprites/icons/t_torch.svg", "power": 1.45, "add": {"flames": 2.0, "radius": 15.0}, "strikes": [], "sprite": "res://assets/sprites/spark.svg"}, {"name": "Glass Lanterns", "desc": "A ring of bright lantern sparks.", "icon": "res://assets/sprites/icons/t_lantern.svg", "power": 1.7, "add": {"flames": 3.0, "radius": 25.0, "hit_interval": -0.05}, "strikes": [], "sprite": "res://assets/sprites/spark.svg"}, {"name": "Gaslight Ring", "desc": "Fast, wide gaslight flames.", "icon": "res://assets/sprites/icons/t_lantern.svg", "power": 2.0, "add": {"flames": 3.0, "radius": 35.0, "rot_speed": 0.6, "hit_interval": -0.1}, "strikes": [], "sprite": "res://assets/sprites/spark.svg"}, {"name": "Arc Lamps + Flare Rockets", "desc": "Crackling arc lamps and flare rockets. Calls a Flare Rockets every 8 s.", "icon": "res://assets/sprites/icons/t_plasma.svg", "power": 2.3, "add": {"flames": 4.0, "radius": 40.0, "rot_speed": 0.6, "hit_interval": -0.1}, "strikes": [{"type": "missiles", "name": "Flare Rockets", "cooldown": 8.0, "damage": 55.0, "area": 100.0, "count": 3.0}], "sprite": "res://assets/sprites/plasma.svg"}, {"name": "Plasma Halo", "desc": "A plasma halo, rockets and a drone sweep. Calls a Flare Rockets every 8 s. Calls a Drone Sweep every 10 s.", "icon": "res://assets/sprites/icons/t_plasma.svg", "power": 2.7, "add": {"flames": 4.0, "radius": 50.0, "rot_speed": 0.8, "hit_interval": -0.12}, "strikes": [{"type": "missiles", "name": "Flare Rockets", "cooldown": 8.0, "damage": 55.0, "area": 100.0, "count": 4.0}, {"type": "jet", "name": "Drone Sweep", "cooldown": 10.0, "damage": 70.0, "area": 110.0}], "sprite": "res://assets/sprites/plasma.svg"}])
